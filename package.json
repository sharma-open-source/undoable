{
  "name": "@sharma/undoable",
  "version": "0.1.1",
  "description": "A runtime for optimistic, undoable mutations. One primitive, no UI.",
  "keywords": [
    "undo",
    "optimistic",
    "optimistic-ui",
    "accessibility",
    "focus-management"
  ],
  "license": "MIT",
  "author": "Sharma Sathananthan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharma-open-source/undoable.git"
  },
  "homepage": "https://github.com/sharma-open-source/undoable#readme",
  "bugs": "https://github.com/sharma-open-source/undoable/issues",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/undoable.cjs",
  "module": "./dist/undoable.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/undoable.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/undoable.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/*"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example": "npm run build && node examples/serve.js",
    "probe": "npm run build && node examples/probe.mjs",
    "probe:browser": "npm run build && node examples/browser-probe.mjs"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
